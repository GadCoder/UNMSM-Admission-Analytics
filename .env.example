# PostgreSQL
POSTGRES_DB=unmsm_admission_analytics
POSTGRES_USER=unmsm
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me-for-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://unmsm:change-me@postgres:5432/unmsm_admission_analytics
# Reuse PostgreSQL connections for up to 60 seconds; use 0 to disable reuse.
DATABASE_CONN_MAX_AGE=60

# Shared Valkey cache. The redis:// scheme is the compatible wire protocol.
CACHE_VALKEY_URL=redis://valkey:6379/0

# Observability: generate a dedicated random token for the backend and Prometheus.
# Empty disables /metrics/. Never use the Grafana admin password here.
METRICS_BEARER_TOKEN=
APP_RELEASE=local

# React/Vite
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Public browser telemetry collector URL; empty disables usage collection.
# This is a frontend BUILD argument in Dokploy, never a secret.
VITE_FARO_URL=
